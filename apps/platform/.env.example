# InstantDB
VITE_INSTANT_APP_ID=b9227417-33f4-4c3d-9c88-612e094aff89
INSTANTDB_ADMIN_TOKEN=

# Chargily Pay — platform subscriptions
CHARGILY_PLATFORM_SECRET_KEY=

# App URL (used in Chargily callback)
VITE_APP_URL=http://localhost:3001

# Google OAuth (buyer auth gate)
VITE_GOOGLE_CLIENT_ID=

# Download URLs (optional — defaults to GitHub archive)
DOWNLOAD_URL_STORE_SOURCE=
DOWNLOAD_URL_STORE_APP=
DOWNLOAD_URL_PLATFORM_SOURCE=

# InstantDB platform personal token — auto-provisions store databases for merchants
INSTANTDB_PLATFORM_PERSONAL_TOKEN=

# Cloudflare OAuth — one-click linking (register at dash.cloudflare.com/profile/developer-applications)
# Scopes needed: account:read user:read workers:write workers_routes:write zone:read dns:write
# (no Cloudflare KV/D1/DB scopes — storage is InstantDB only)
# NOTE: the client id is needed BOTH client-side (VITE_, renders the button) and server-side
# (CF_OAUTH_CLIENT_ID, used by exchangeCloudflareOAuth for the token exchange) — set the same value in both.
VITE_CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_SECRET=

# InstantDB Platform OAuth — lets merchants connect their OWN InstantDB account so stores
# deploy to their own database. Register an OAuth app + client in the InstantDB dashboard.
# Scopes: apps-read apps-write. Redirect: <app-url>/auth/instantdb
# NOTE: InstantDB OAuth apps start in TEST MODE (access limited to app members) until the
# InstantDB team approves the app for public use. Connection works for the team immediately.
# Like CF above, the client id is needed BOTH client-side (VITE_, renders the button) and
# server-side (INSTANTDB_OAUTH_CLIENT_ID, used by exchangeInstantDBOAuth) — set the same value in both.
VITE_INSTANTDB_OAUTH_CLIENT_ID=
INSTANTDB_OAUTH_CLIENT_ID=
INSTANTDB_OAUTH_CLIENT_SECRET=
