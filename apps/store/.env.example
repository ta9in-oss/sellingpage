# InstantDB (your store's own app)
VITE_INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=

# Google OAuth (buyer auth — required when payment method = chargily)
VITE_GOOGLE_CLIENT_ID=

# Chargily Pay (required when payment method = chargily)
CHARGILY_SECRET_KEY=
VITE_CHARGILY_PUBLIC_KEY=

# App URL (used in Chargily callback)
VITE_APP_URL=http://localhost:3000
