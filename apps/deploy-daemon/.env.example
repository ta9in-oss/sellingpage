# deploy-daemon environment (copy to .env on the build box; never commit the real one)

# Port the daemon listens on (localhost only; Caddy proxies to it).
PORT=8787

# Global build concurrency. KEEP 1 — the daemon reuses one working tree and writes
# shared config files under apps/store/src/config; parallel builds clobber each other.
DEPLOY_CONCURRENCY=1

# Shared secret the platform sends as `Authorization: Bearer <...>`. Mint with:
#   openssl rand -hex 32
# Must be byte-identical to the platform's DEPLOY_SHARED_SECRET Pages secret.
DEPLOY_SHARED_SECRET=

# Platform InstantDB app id (public) + admin token (secret). Same values the
# GitHub workflow used as PLATFORM_VITE_INSTANT_APP_ID / PLATFORM_INSTANTDB_ADMIN_TOKEN.
VITE_INSTANT_APP_ID=
PLATFORM_INSTANTDB_ADMIN_TOKEN=

# Opens merchant secrets sealed at rest. MUST equal the platform's STORE_SECRET_KEY
# Pages secret and the value in GitHub. If it differs, deploys fail loudly with
# "Could not decrypt secret — wrong STORE_SECRET_KEY".
STORE_SECRET_KEY=

# Public Google OAuth client id baked into the store build (not a secret).
VITE_GOOGLE_CLIENT_ID=1031735082979-bjhvq3ulo8gsmebkeihkalh3gohoropm.apps.googleusercontent.com
