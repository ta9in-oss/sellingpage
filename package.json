{
  "name": "7aba",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --filter platform --filter store run build",
    "lint": "biome lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@instantdb/admin": "^1.0.67",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1"
    }
  },
  "description": "Open-source store builder and one-page selling store for Algerian merchants (TanStack Start + InstantDB + Cloudflare).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ta9in-oss/sellingpage.git"
  },
  "engines": {
    "node": ">=22.12"
  }
}
